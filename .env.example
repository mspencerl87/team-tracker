# Copy to .env next to docker-compose.yml. Placeholders only.

# The address people open, without a trailing slash. The OIDC redirect URI
# to register with your provider is PUBLIC_URL/auth/callback.
PUBLIC_URL=https://team.example.com

# OIDC sign-in (Google Workspace, Microsoft Entra, Authentik, Keycloak...).
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=replace-me.apps.googleusercontent.com
OIDC_CLIENT_SECRET=replace-me
OIDC_LABEL=Sign in with Google

# Only these email domains can sign in (comma-separated). Leave this set.
ALLOWED_EMAIL_DOMAINS=example.com
# These accounts become admins when they sign in (comma-separated).
ADMIN_EMAILS=you@example.com

# Break-glass admin login for setup and for when the provider is down. Optional.
ADMIN_PASSWORD=change-me
# Long random string; keeps people signed in across restarts.
SESSION_SECRET=replace-with-a-long-random-string
