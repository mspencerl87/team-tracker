# Copy to .env next to docker-compose.yml. Placeholders only.

# The address people open Team Tracker at, without a trailing slash (its own
# hostname, not your company website). Sign-in redirects to PUBLIC_URL/auth/callback.
PUBLIC_URL=https://team.example.com

# --- Sign-in: pick ONE of the two blocks below, or neither (admin password only).

# A) Matrix homeserver with Matrix Authentication Service (like matrix-search-hub).
#    The domain in your Matrix IDs (@you:example.com). Team Tracker finds the
#    login server from it and registers itself there; nothing to set up.
MATRIX_SERVER_NAME=https://example.com
# Matrix IDs or emails that become admins when they sign in (comma-separated).
ADMIN_USER_IDS=@you:example.com

# B) Any other OIDC provider (Google Workspace, Microsoft Entra, Authentik...).
#    See the README for each provider's issuer and how to get the client.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=replace-me
# OIDC_CLIENT_SECRET=replace-me
# OIDC_LABEL=Sign in with Google
# Only these email domains can sign in (comma-separated). Needed with B.
# ALLOWED_EMAIL_DOMAINS=example.com
# ADMIN_EMAILS=you@example.com

# Break-glass admin login for setup and for when sign-in is down. Optional.
ADMIN_PASSWORD=change-me
# Keeps people signed in across restarts. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32
